# Unity 项目标准 .gitignore
# 核心缓存/临时文件夹
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
[Pp]ackageCache/
[Uu]serSettings/
[Pp]rogress/

# 系统文件
.DS_Store
Thumbs.db
Desktop.ini

# 解决方案/项目文件
*.csproj
*.unityproj
*.sln
*.user
*.userprefs
*.suo
*.pidb
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# IDE 配置
.vs/
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# 版本控制
.git/
.svn/
.hg/